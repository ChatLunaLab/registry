{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatluna-registry-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  // Cron-only Worker: no public URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
