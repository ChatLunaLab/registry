{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatluna-registry-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  // Public only on the custom domain below; no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chatluna-registry.dingyi222666.top", "custom_domain": true }],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
